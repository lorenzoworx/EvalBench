# Static-only public replay: this image contains no Python, API, or inference service.
FROM node:24-alpine AS build
WORKDIR /app
COPY frontend/package*.json ./
RUN npm ci
COPY frontend/ ./
RUN npm run build:demo \
    && chmod -R a+rX /app/dist-demo

FROM nginx:stable-alpine
RUN sed -i -E 's/^nginx:x:[0-9]+:/nginx:x:10001:/' /etc/group \
    && sed -i -E 's/^nginx:x:[0-9]+:[0-9]+:/nginx:x:10001:10001:/' /etc/passwd
COPY --chown=10001:10001 --chmod=0444 deployment/nginx.conf /etc/nginx/nginx.conf
COPY --chown=10001:10001 --chmod=0444 deployment/replay.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/dist-demo/ /usr/share/nginx/html/
USER 10001:10001
EXPOSE 8000
HEALTHCHECK --interval=10s --timeout=5s --start-period=5s --retries=6 \
    CMD wget -qO- http://127.0.0.1:8000/replay-data.json >/dev/null
