# Static-only public replay: this image contains no Python, API, or inference service.
FROM node:24-alpine AS build
WORKDIR /app
COPY frontend/package*.json ./
RUN npm ci
COPY frontend/ ./
RUN npm run build:demo

FROM nginx:stable-alpine
COPY deployment/replay.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/dist-demo/ /usr/share/nginx/html/
EXPOSE 8080
